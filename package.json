{
  "name": "simkl-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Simkl API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "refresh:openapi": "bun run scripts/refresh-openapi.ts",
    "codegen": "bun run scripts/codegen.ts",
    "codegen:check": "bun run codegen && git diff --exit-code HEAD -- generated/tools.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "capabilities": "bun run scripts/capabilities.ts",
    "capabilities:check": "bun run capabilities && git diff --exit-code -- static/capabilities.json",
    "smoke:capabilities": "bun run scripts/smoke-capabilities.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "simkl",
    "tracking",
    "anime",
    "movies",
    "tv-shows"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.2.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "agents": "^0.24.0",
    "oauth4webapi": "^3.8.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^22",
    "typescript": "^7.0.2",
    "wrangler": "^4.146.0"
  }
}
